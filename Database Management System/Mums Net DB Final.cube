  <Source dwd:design-time-name="e4000f21-a503-47be-b748-8a77dd3fb027">
    <DataSourceViewID>Mums Net DB Final</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="17e3a8f0-18e4-457d-80dd-2dc9c3a15069">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text> 
CREATE MEMBER CURRENTCUBE.[Measures].TotalCancelledOrders
 AS SUM(
    FILTER(
        [Orders].[Order Status Code].MEMBERS,
        [Orders].[Order Status Code].CURRENTMEMBER.Properties("Key") = "3"
    ),
    [Measures].[Order Number Distinct Count]
), 
FORMAT_STRING = "Standard", 
VISIBLE = 1  ;  
CREATE MEMBER CURRENTCUBE.[Measures].TotalFulfilledOrders
 AS SUM(
    FILTER(
        [Orders].[Order Status Code].MEMBERS,
        [Orders].[Order Status Code].CURRENTMEMBER.Properties("Key") = "4"
    ),
    [Measures].[Order Number Distinct Count]
), 
VISIBLE = 1  ;  
CREATE MEMBER CURRENTCUBE.[Measures].PerFulfilledOrders
 AS IIF(
    [Measures].[Order Number Distinct Count] = 0,
    NULL, -- To avoid division by zero
    ([Measures].[TotalFulfilledOrders] / [Measures].[Order Number Distinct Count]) * 100
), 
VISIBLE = 1  ;   
CREATE MEMBER CURRENTCUBE.[Measures].SalesValueOfCancelledOrders
 AS SUM(
    FILTER(
        [Orders].[Order Status Code].MEMBERS,
        [Orders].[Order Status Code].CURRENTMEMBER.Properties("Key") = "3"
    ),
    [Measures].[Line Item Total]
), 
VISIBLE = 1  ;    
CREATE MEMBER CURRENTCUBE.[Measures].TotalAbandonedOrders
 AS SUM(
    FILTER(
        [Orders].[Order Status Code].MEMBERS,
        [Orders].[Order Status Code].CURRENTMEMBER.Properties("Key") = "1"
    ),
    [Measures].[Order Number Distinct Count]
), 
VISIBLE = 1  ;    
CREATE MEMBER CURRENTCUBE.[Measures].PerAbandonedOrders
 AS IIF(
    [Measures].[Order Number Distinct Count] = 0,
    NULL, -- To avoid division by zero
    ([Measures].[TotalAbandonedOrders] / [Measures].[Order Number Distinct Count]) * 100
), 
VISIBLE = 1  ;     
CREATE MEMBER CURRENTCUBE.[Measures].TotalUnfulfilledOrders
 AS SUM(
    FILTER(
        [Orders].[Order Status Code].MEMBERS,
        [Orders].[Order Status Code].CURRENTMEMBER.Properties("Key") = "2"
    ),
    [Measures].[Order Number Distinct Count]
), 
VISIBLE = 1  ;     
CREATE MEMBER CURRENTCUBE.[Measures].PerCancelledOrders
 AS IIF(
    [Measures].[Order Number Distinct Count] = 0,
    NULL, -- To avoid division by zero
    ([Measures].[TotalCancelledOrders] / [Measures].[Order Number Distinct Count]) * 100
), 
VISIBLE = 1  ;  
CREATE MEMBER CURRENTCUBE.[Measures].SalesOfSoldOrders
 AS SUM(
    FILTER(
        [Orders].[Order Status Code].MEMBERS,
        [Orders].[Order Status Code].CURRENTMEMBER.Properties("Key") = "4"
    ),
    [Measures].[Line Item Total]
), 
VISIBLE = 1  ;     
CREATE MEMBER CURRENTCUBE.[Measures].PerUnfulfilledOrders
 AS IIF(
    [Measures].[Order Number Distinct Count] = 0,
    NULL, -- To avoid division by zero
    ([Measures].[TotalUnfulfilledOrders] / [Measures].[Order Number Distinct Count]) * 100
), 
VISIBLE = 1  ;      /*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE;  
CREATE MEMBER CURRENTCUBE.[Measures].QuantityOfSoldOrders
 AS SUM(
    FILTER(
        [Orders].[Order Status Code].MEMBERS,
        [Orders].[Order Status Code].CURRENTMEMBER.Properties("Key") = "4"
    ),
   [Measures].[Quantity]
), 
VISIBLE = 1  ;  
CREATE MEMBER CURRENTCUBE.[Measures].OrderStockQuantity
 AS SUM(
    FILTER(
        [Orders].[Order Status Code].MEMBERS,
        [Orders].[Order Status Code].CURRENTMEMBER.Properties("Key") = "3" 
        or [Orders].[Order Status Code].CURRENTMEMBER.Properties("Key") = "4"
    ),
    [Measures].[Quantity]
), 
VISIBLE = 1  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>